# OCI Object Storage is S3-compatible. Terraform calls this backend "s3" and
# reads AWS_* variables, but the credentials are OCI Customer Secret Keys and
# the endpoint is oraclecloud.com. No AWS account is involved.
#
# Copy this block into a backend.tf and run `terraform init -migrate-state`.
# The pipeline generates the equivalent file with scripts/ci-backend.sh.

terraform {
  backend "s3" {
    bucket   = "oci-platform-core-tfstate"
    key      = "oci-platform-core/prod/terraform.tfstate"
    region   = "us-east-1" # required by the S3 backend, ignored by OCI
    endpoint = "https://<namespace>.compat.objectstorage.us-ashburn-1.oraclecloud.com"

    access_key = "REPLACE_WITH_OCI_CUSTOMER_SECRET_KEY_ID"
    secret_key = "REPLACE_WITH_OCI_CUSTOMER_SECRET_KEY"

    skip_region_validation      = true
    skip_credentials_validation = true
    skip_metadata_api_check     = true
    skip_requesting_account_id  = true
    skip_s3_checksum            = true
    force_path_style            = true

    # Prefer environment variables over literals:
    #   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
  }
}
