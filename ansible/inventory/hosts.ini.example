# Generate the real file from Terraform:
#   make inventory ENV=dev
#
# Then either run Ansible ON the ops runner (the generated file uses
# localhost for the ops play), or override [ops] with the runner's public IP.
#
# Do not hardcode IP addresses in Git.

[app]
10.20.10.10 ansible_user=deploy
10.20.10.11 ansible_user=deploy

[ops]
localhost ansible_connection=local

[all:vars]
ansible_python_interpreter=/usr/bin/python3
